# Postgres (docker-compose.yml)
POSTGRES_USER=adikara
POSTGRES_PASSWORD=adikara
POSTGRES_DB=adikara

# API
DATABASE_URL=postgresql://adikara:adikara@localhost:5433/adikara
PORT=8080
# Required, at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=60
BCRYPT_COST=12
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Live sessions: join attempts per student per window, session lifetime, grace before a dropped stream counts as "left"
JOIN_RATE_LIMIT_MAX=10
JOIN_RATE_LIMIT_WINDOW_MINUTES=1
SESSION_TTL_MINUTES=240
SESSION_PRESENCE_GRACE_SECONDS=10
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Swagger UI at /docs. Defaults to on, except when NODE_ENV=production.
DOCS_ENABLED=true

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Seed: optional in development (defaults to admin@adikara.com / ChangeMe-123).
# Required when NODE_ENV=production.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Material uploads. Cloudflare R2 (S3 API): set all four or none; the worker in adikara-ai reads the same bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
UPLOAD_MAX_MB=20

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAF           @map("Draf")
  DISETUJUI      @map("Disetujui")
  DIPUBLIKASIKAN @map("Dipublikasikan")

  @@map("content_status")
}

enum MaterialStatus {
  UPLOADED  @map("uploaded")
  EXTRACTED @map("extracted")
  FAILED    @map("failed")

  @@map("material_status")
}

enum Pillar {
  DEKOMPOSISI @map("dekomposisi")
  POLA        @map("pola")
  ABSTRAKSI   @map("abstraksi")
  ALGORITMA   @map("algoritma")

  @@map("pillar")
}

enum ItemType {
  BOARD         @map("board")
  TEACHING_CARD @map("teaching_card")
  PRACTICE      @map("practice")

  @@map("item_type")
}

enum TestPhase {
  PRETEST  @map("pretest")
  POSTTEST @map("posttest")

  @@map("test_phase")
}

enum DiagnosisStatus {
  PERLU_DIPERIKSA         @map("perlu_diperiksa")
  KEMUNGKINAN_MISKONSEPSI @map("kemungkinan_miskonsepsi")
  TERATASI                @map("teratasi")

  @@map("diagnosis_status")
}

enum JobType {
  EXTRACT          @map("extract")
  GENERATE_PACKAGE @map("generate_package")
  GENERATE_PROBLEM @map("generate_problem")
  CHAT_REPLY       @map("chat_reply")
  GENERATE_REPORT  @map("generate_report")

  @@map("job_type")
}

enum JobStatus {
  QUEUED  @map("queued")
  RUNNING @map("running")
  DONE    @map("done")
  FAILED  @map("failed")

  @@map("job_status")
}

// ---------- Akun dan kelas ----------

// ADMIN manages all teacher and student data. A teacher account with role
// ADMIN is an admin; USER is a student.
enum Role {
  ADMIN   @map("admin")
  TEACHER @map("teacher")
  USER    @map("user")

  @@map("role")
}

model Teacher {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String         @map("password_hash")
  name         String
  role         Role           @default(TEACHER)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  classrooms   Classroom[]
  sessions     ClassSession[]
  chats        Chat[]
  materials    Material[]
  packages     Package[]
  problems     BlockProblem[]

  @@index([role])
  @@map("teachers")
}

model Classroom {
  id         String         @id @default(uuid()) @db.Uuid
  teacherId  String         @map("teacher_id") @db.Uuid
  name       String
  classCode  String         @unique @map("class_code")
  archivedAt DateTime?      @map("archived_at") @db.Timestamptz
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  teacher    Teacher        @relation(fields: [teacherId], references: [id])
  students   Student[]
  sessions   ClassSession[]
  packages   ClassPackage[]
  reports    ClassReport[]

  @@index([teacherId])
  @@map("classes")
}

/// AI feedback for a teacher about one class: `input` is the snapshot of the class's results the AI read (so the
/// feedback stays explainable after new sessions), `feedback` what the AI worker wrote back.
model ClassReport {
  id         String    @id @default(uuid()) @db.Uuid
  classId    String    @map("class_id") @db.Uuid
  teacherId  String    @map("teacher_id") @db.Uuid
  /// "pending" until the AI worker fills it, then "done" or "failed"
  status     String    @default("pending")
  input      Json
  feedback   Json?
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  classroom  Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, createdAt])
  @@map("class_reports")
}

model Student {
  id                  String               @id @default(uuid()) @db.Uuid
  classId             String               @map("class_id") @db.Uuid
  tokenHash           String?              @unique @map("token_hash")
  username            String?              @unique
  passwordHash        String?              @map("password_hash")
  alias               String?
  role                Role                 @default(USER)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt          DateTime?            @map("last_seen_at") @db.Timestamptz
  classroom           Classroom            @relation(fields: [classId], references: [id])
  attempts            Attempt[]
  practiceSubmissions PracticeSubmission[]
  diagnoses           Diagnosis[]
  sessionParticipants SessionParticipant[]
  quizAttempts        QuizAttempt[]
  problemAttempts     ProblemAttempt[]

  @@index([classId])
  @@map("students")
}

// ---------- Sesi kelas live ----------

enum SessionStatus {
  LOBBY
  ACTIVE
  ENDED

  @@map("session_status")
}

/// One live class meeting. `joinCode` is the 6-digit PIN students type; it is set to NULL when the session ends,
/// so the PIN can be reused later (NULLs do not collide in a unique index).
model ClassSession {
  id           String               @id @default(uuid()) @db.Uuid
  classId      String               @map("class_id") @db.Uuid
  teacherId    String               @map("teacher_id") @db.Uuid
  joinCode     String?              @unique @map("join_code")
  status       SessionStatus        @default(LOBBY)
  locked       Boolean              @default(false)
  startedAt    DateTime?            @map("started_at") @db.Timestamptz
  endedAt      DateTime?            @map("ended_at") @db.Timestamptz
  expiresAt    DateTime             @map("expires_at") @db.Timestamptz
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  classroom    Classroom            @relation(fields: [classId], references: [id])
  teacher      Teacher              @relation(fields: [teacherId], references: [id])
  participants SessionParticipant[]
  chatId       String?              @map("chat_id") @db.Uuid
  chat         Chat?                @relation(fields: [chatId], references: [id], onDelete: SetNull)
  board        SessionBoard?
  quizzes      SessionQuiz[]
  problems     SessionProblem[]

  @@index([classId, status])
  @@index([teacherId])
  @@index([chatId])
  @@map("class_sessions")
}

/// The teacher's whiteboard for a session: an Excalidraw scene (`{ elements, appState }`). Kept apart from the
/// session row because it can be large and every session read would otherwise carry it.
model SessionBoard {
  sessionId String       @id @map("session_id") @db.Uuid
  scene     Json
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_boards")
}

/// Attendance: one row per student per session.
model SessionParticipant {
  id        String       @id @default(uuid()) @db.Uuid
  sessionId String       @map("session_id") @db.Uuid
  studentId String       @map("student_id") @db.Uuid
  joinedAt  DateTime     @default(now()) @map("joined_at") @db.Timestamptz
  leftAt    DateTime?    @map("left_at") @db.Timestamptz
  kickedAt  DateTime?    @map("kicked_at") @db.Timestamptz
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("session_participants")
}

// ---------- Kuis di sesi ----------

enum QuizStatus {
  OPEN   @map("open")
  CLOSED @map("closed")

  @@map("quiz_status")
}

/// A test the teacher put on the board of a session. `questions` is a frozen copy (text, options, answer key,
/// explanation, source), so editing the test later never changes the results; `source_*` says where it came from.
model SessionQuiz {
  id              String        @id @default(uuid()) @db.Uuid
  sessionId       String        @map("session_id") @db.Uuid
  kind            String // pretest | posttest | quiz
  title           String
  questions       Json
  status          QuizStatus    @default(OPEN)
  sourceChatId    String?       @map("source_chat_id") @db.Uuid
  sourceMessageId String?       @map("source_message_id") @db.Uuid
  openedAt        DateTime      @default(now()) @map("opened_at") @db.Timestamptz
  closedAt        DateTime?     @map("closed_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  session         ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attempts        QuizAttempt[]

  @@index([sessionId])
  @@map("session_quizzes")
}

/// One student's go at a quiz (one per student). `entry` is how they opened it (board, qr, link); `client` the device.
model QuizAttempt {
  id          String         @id @default(uuid()) @db.Uuid
  quizId      String         @map("quiz_id") @db.Uuid
  studentId   String         @map("student_id") @db.Uuid
  startedAt   DateTime       @default(now()) @map("started_at") @db.Timestamptz
  submittedAt DateTime?      @map("submitted_at") @db.Timestamptz
  score       Int?
  total       Int
  durationMs  Int?           @map("duration_ms")
  entry       String?
  client      Json?
  quiz        SessionQuiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  responses   QuizResponse[]

  @@unique([quizId, studentId])
  @@index([studentId])
  @@map("quiz_attempts")
}

/// The answer to one question, with how it was reached: the first pick, every change (`changes`: [{choice, at_ms}]),
/// time spent on the question, how often it was opened, and the order it was answered in. For analysing where a class
/// goes wrong, not only how many it got right.
model QuizResponse {
  id          String      @id @default(uuid()) @db.Uuid
  attemptId   String      @map("attempt_id") @db.Uuid
  questionId  Int         @map("question_id")
  choice      String
  firstChoice String      @map("first_choice")
  isCorrect   Boolean     @map("is_correct")
  timeMs      Int         @map("time_ms")
  visits      Int         @default(1)
  changes     Json
  answerOrder Int         @map("answer_order")
  answeredAt  DateTime    @default(now()) @updatedAt @map("answered_at") @db.Timestamptz
  attempt     QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("quiz_responses")
}

// ---------- Soal pemecahan masalah (blok) ----------

/// A problem-solving exercise a teacher drafts: a story and one challenge, solved with blocks (arrange the given
/// blocks, distractors included, into the answer) and/or JavaScript (a function that passes the teacher's tests).
/// `challenge` holds both; see lib/block-puzzle.ts.
/// `chatId` is the material it belongs to. An AI draft is written by the worker (job `generate_problem`): `generation`
/// is "pending" until then, "failed" (with `generationError`, safe to show) when it could not be made, else null.
model BlockProblem {
  id              String           @id @default(uuid()) @db.Uuid
  teacherId       String           @map("teacher_id") @db.Uuid
  chatId          String?          @map("chat_id") @db.Uuid
  title           String
  story           String           @default("")
  status          ContentStatus    @default(DRAF)
  challenge       Json
  origin          String           @default("manual") // manual | ai
  aiFocus         String?          @map("ai_focus")
  generation      String?
  generationError String?          @map("generation_error")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  teacher         Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  chat            Chat?            @relation(fields: [chatId], references: [id], onDelete: SetNull)
  sent            SessionProblem[]

  @@index([teacherId, updatedAt])
  @@index([chatId])
  @@map("block_problems")
}

/// A problem the teacher sent to the class during a session; it pops up on every student's screen. `challenge` is a
/// frozen copy, so editing the problem later never changes what the class solved.
model SessionProblem {
  id        String           @id @default(uuid()) @db.Uuid
  sessionId String           @map("session_id") @db.Uuid
  problemId String?          @map("problem_id") @db.Uuid
  title     String
  story     String
  challenge Json
  status    QuizStatus       @default(OPEN)
  openedAt  DateTime         @default(now()) @map("opened_at") @db.Timestamptz
  closedAt  DateTime?        @map("closed_at") @db.Timestamptz
  session   ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  problem   BlockProblem?    @relation(fields: [problemId], references: [id], onDelete: SetNull)
  attempts  ProblemAttempt[]

  @@index([sessionId])
  @@map("session_problems")
}

/// One student's work on a sent problem: the last block arrangement and code, how often each was checked, and when
/// and how (`solvedWith`: blocks | code) it was first solved. Code is run in the student's browser; `codePassed` is
/// what it reported.
model ProblemAttempt {
  id          String         @id @default(uuid()) @db.Uuid
  problemId   String         @map("problem_id") @db.Uuid
  studentId   String         @map("student_id") @db.Uuid
  startedAt   DateTime       @default(now()) @map("started_at") @db.Timestamptz
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  solvedAt    DateTime?      @map("solved_at") @db.Timestamptz
  solvedWith  String?        @map("solved_with")
  blockChecks Int            @default(0) @map("block_checks")
  blockAnswer Json?          @map("block_answer")
  codeRuns    Int            @default(0) @map("code_runs")
  code        String?
  codePassed  Int?           @map("code_passed")
  codeTotal   Int?           @map("code_total")
  problem     SessionProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([problemId, studentId])
  @@index([studentId])
  @@map("problem_attempts")
}

// ---------- Chat dan RAG per chat ----------

enum ChatRole {
  USER      @map("user")
  ASSISTANT @map("assistant")

  @@map("chat_role")
}

/// A teacher's workspace for preparing class material. It is the isolation boundary of RAG: a chat only reads the
/// materials attached to it (`ChatMaterial`) and its own messages. Many class sessions may point at one chat,
/// so the teacher prepares once and reuses it in the next class.
model Chat {
  id        String         @id @default(uuid()) @db.Uuid
  teacherId String         @map("teacher_id") @db.Uuid
  title     String
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  teacher   Teacher        @relation(fields: [teacherId], references: [id])
  messages  ChatMessage[]
  materials ChatMaterial[]
  sessions  ClassSession[]
  problems  BlockProblem[]

  @@index([teacherId])
  @@map("chats")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @map("chat_id") @db.Uuid
  role      ChatRole
  content   String
  sources   Json? // material_chunks ids the assistant answered from
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("chat_messages")
}

/// The materials a chat may use. A re-uploaded file is a new Material, so a chat never changes under the teacher.
model ChatMaterial {
  chatId     String   @map("chat_id") @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([chatId, materialId])
  @@index([materialId])
  @@map("chat_materials")
}

/// A material's chunks, embedded once by the Python worker. Retrieval always joins `chat_materials` on the chat,
/// so a chat sees only its own materials. Vectors are L2-normalized, so `<=>` (cosine) works on them directly.
/// The vector column is created in raw SQL (Prisma has no vector type); a model with another size needs a migration.
model MaterialChunk {
  id             String                      @id @default(uuid()) @db.Uuid
  materialId     String                      @map("material_id") @db.Uuid
  chunkIndex     Int                         @map("chunk_index")
  label          String
  text           String
  embedding      Unsupported("vector(1024)")
  embeddingModel String                      @map("embedding_model")
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  material       Material                    @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, embeddingModel, chunkIndex])
  @@map("material_chunks")
}

// ---------- Materi dan paket ----------

model Material {
  id            String          @id @default(uuid()) @db.Uuid
  teacherId     String          @map("teacher_id") @db.Uuid
  title         String
  filePath      String          @map("file_path")
  fileType      String          @map("file_type") // pdf | pptx
  extractedText String?         @map("extracted_text")
  status        MaterialStatus  @default(UPLOADED)
  error         String? // why extraction failed; safe to show the teacher
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  teacher       Teacher         @relation(fields: [teacherId], references: [id])
  packages      Package[]
  chunks        MaterialChunk[]
  chats         ChatMaterial[]

  @@map("materials")
}

model Package {
  id            String         @id @default(uuid()) @db.Uuid
  materialId    String         @map("material_id") @db.Uuid
  teacherId     String         @map("teacher_id") @db.Uuid
  title         String
  status        ContentStatus  @default(DRAF)
  aiModel       String?        @map("ai_model")
  publishedAt   DateTime?      @map("published_at") @db.Timestamptz
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  material      Material       @relation(fields: [materialId], references: [id])
  teacher       Teacher        @relation(fields: [teacherId], references: [id])
  classPackages ClassPackage[]
  concepts      Concept[]
  items         PackageItem[]
  questions     Question[]
  practiceTasks PracticeTask[]
  attempts      Attempt[]

  @@index([teacherId, status])
  @@index([materialId])
  @@map("packages")
}

model ClassPackage {
  classId   String    @map("class_id") @db.Uuid
  packageId String    @map("package_id") @db.Uuid
  openedAt  DateTime  @default(now()) @map("opened_at") @db.Timestamptz
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  package   Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([classId, packageId])
  @@map("class_packages")
}

model Concept {
  id            String         @id @default(uuid()) @db.Uuid
  packageId     String         @map("package_id") @db.Uuid
  name          String
  description   String?
  pillar        Pillar
  boardJson     Json?          @map("board_json")
  position      Int            @default(0)
  package       Package        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  items         PackageItem[]
  questions     Question[]
  practiceTasks PracticeTask[]
  diagnoses     Diagnosis[]

  @@index([packageId])
  @@map("concepts")
}

model PackageItem {
  id          String        @id @default(uuid()) @db.Uuid
  packageId   String        @map("package_id") @db.Uuid
  conceptId   String?       @map("concept_id") @db.Uuid
  itemType    ItemType      @map("item_type")
  contentJson Json          @map("content_json")
  status      ContentStatus @default(DRAF)
  position    Int           @default(0)
  package     Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  concept     Concept?      @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([packageId])
  @@map("package_items")
}

// ---------- Soal dan latihan ----------

model Question {
  id        String        @id @default(uuid()) @db.Uuid
  packageId String        @map("package_id") @db.Uuid
  conceptId String        @map("concept_id") @db.Uuid
  phase     TestPhase
  pairId    String?       @unique @map("pair_id") @db.Uuid // posttest pairs with a pretest
  stem      String
  status    ContentStatus @default(DRAF)
  position  Int           @default(0)
  package   Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  concept   Concept       @relation(fields: [conceptId], references: [id], onDelete: NoAction)
  pair      Question?     @relation("QuestionPair", fields: [pairId], references: [id], onDelete: SetNull)
  pairedBy  Question?     @relation("QuestionPair")
  options   Option[]
  answers   Answer[]

  @@index([packageId, phase, position])
  @@map("questions")
}

model Option {
  id                 String   @id @default(uuid()) @db.Uuid
  questionId         String   @map("question_id") @db.Uuid
  text               String
  isCorrect          Boolean  @default(false) @map("is_correct")
  misconceptionLabel String?  @map("misconception_label") // null when correct
  position           Int      @default(0)
  question           Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers            Answer[]

  @@index([questionId])
  @@map("options")
}

model PracticeTask {
  id           String               @id @default(uuid()) @db.Uuid
  packageId    String               @map("package_id") @db.Uuid
  conceptId    String               @map("concept_id") @db.Uuid
  pillar       Pillar
  prompt       String
  startBlocks  Json?                @map("start_blocks")
  expectedJson Json?                @map("expected_json")
  refPython    String?              @map("ref_python")
  refJs        String?              @map("ref_js")
  package      Package              @relation(fields: [packageId], references: [id], onDelete: Cascade)
  concept      Concept              @relation(fields: [conceptId], references: [id], onDelete: NoAction)
  hints        Hint[]
  submissions  PracticeSubmission[]

  @@index([packageId])
  @@map("practice_tasks")
}

model Hint {
  id     String       @id @default(uuid()) @db.Uuid
  taskId String       @map("task_id") @db.Uuid
  level  Int          @db.SmallInt // 1..3
  text   String
  task   PracticeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, level])
  @@map("hints")
}

// ---------- Hasil dan diagnosis ----------

model Attempt {
  id          String      @id @default(uuid()) @db.Uuid
  studentId   String      @map("student_id") @db.Uuid
  packageId   String      @map("package_id") @db.Uuid
  phase       TestPhase
  score       Decimal?    @db.Decimal(5, 2)
  startedAt   DateTime    @default(now()) @map("started_at") @db.Timestamptz
  submittedAt DateTime?   @map("submitted_at") @db.Timestamptz
  student     Student     @relation(fields: [studentId], references: [id])
  package     Package     @relation(fields: [packageId], references: [id])
  answers     Answer[]
  diagnoses   Diagnosis[]

  @@unique([studentId, packageId, phase]) // one attempt per phase (MVP)
  @@map("attempts")
}

model Answer {
  id         String   @id @default(uuid()) @db.Uuid
  attemptId  String   @map("attempt_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  optionId   String   @map("option_id") @db.Uuid
  isCorrect  Boolean  @map("is_correct")
  answeredAt DateTime @default(now()) @map("answered_at") @db.Timestamptz
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])
  option     Option   @relation(fields: [optionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("answers")
}

model PracticeSubmission {
  id          String       @id @default(uuid()) @db.Uuid
  studentId   String       @map("student_id") @db.Uuid
  taskId      String       @map("task_id") @db.Uuid
  blocksJson  Json         @map("blocks_json")
  passed      Boolean      @default(false)
  hintsUsed   Int          @default(0) @map("hints_used") @db.SmallInt
  submittedAt DateTime     @default(now()) @map("submitted_at") @db.Timestamptz
  student     Student      @relation(fields: [studentId], references: [id])
  task        PracticeTask @relation(fields: [taskId], references: [id])

  @@index([studentId, taskId])
  @@map("practice_submissions")
}

model Diagnosis {
  id                 String          @id @default(uuid()) @db.Uuid
  studentId          String          @map("student_id") @db.Uuid
  conceptId          String          @map("concept_id") @db.Uuid
  attemptId          String          @map("attempt_id") @db.Uuid
  misconceptionLabel String          @map("misconception_label")
  evidenceCount      Int             @map("evidence_count") @db.SmallInt
  status             DiagnosisStatus
  evidenceJson       Json            @map("evidence_json")
  computedAt         DateTime        @default(now()) @map("computed_at") @db.Timestamptz
  student            Student         @relation(fields: [studentId], references: [id])
  concept            Concept         @relation(fields: [conceptId], references: [id])
  attempt            Attempt         @relation(fields: [attemptId], references: [id])

  @@unique([studentId, conceptId, misconceptionLabel])
  @@index([conceptId, status])
  @@map("diagnoses")
}

// ---------- Sistem ----------

model Job {
  id         String    @id @default(uuid()) @db.Uuid
  type       JobType
  payload    Json
  status     JobStatus @default(QUEUED)
  attempts   Int       @default(0) @db.SmallInt
  error      String?
  resultRef  String?   @map("result_ref") @db.Uuid
  lockedAt   DateTime? @map("locked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz

  @@index([status, createdAt])
  @@map("jobs")
}

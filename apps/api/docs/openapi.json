{
  "openapi": "3.0.3",
  "info": {
    "title": "Adikara API",
    "version": "0.1.0",
    "description": "REST JSON API. Log in at `/auth/login` (or `/auth/student/login`), then press **Authorize** and paste the `access_token`.\n\nErrors always look like `{ \"error\": { \"code\", \"message\", \"details\"? } }`."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "This server"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Login and session. Admins and teachers log in with email, students with username."
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log in as admin or teacher",
        "description": "Returns a JWT. The role in the response is `ADMIN` or `TEACHER`.\n\n**Access:** public (no token needed)\n\n**Middleware:** rate-limit:login",
        "operationId": "post_auth_login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TeacherLoginRequest"
              },
              "example": {
                "email": "guru@example.com",
                "password": "ChangeMe-123"
              }
            }
          }
        },
        "security": [],
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body (field errors are in `error.details.fields`) or malformed JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "validation_error",
                    "message": "Request validation failed",
                    "details": {
                      "fields": {
                        "email": "must be a valid email address"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Wrong credentials. The same answer is given for an unknown account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_credentials",
                    "message": "Invalid credentials"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts from this IP. Try again later.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "too_many_requests",
                    "message": "Too many login attempts, try again later"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error"
                  }
                }
              }
            }
          }
        },
        "x-access": "public"
      }
    },
    "/auth/student/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log in as student",
        "description": "Returns a JWT with role `USER`.\n\n**Access:** public (no token needed)\n\n**Middleware:** rate-limit:login",
        "operationId": "post_auth_student_login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentLoginRequest"
              },
              "example": {
                "username": "siswa.satu",
                "password": "ChangeMe-123"
              }
            }
          }
        },
        "security": [],
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body (field errors are in `error.details.fields`) or malformed JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "validation_error",
                    "message": "Request validation failed",
                    "details": {
                      "fields": {
                        "email": "must be a valid email address"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Wrong credentials. The same answer is given for an unknown account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_credentials",
                    "message": "Invalid credentials"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts from this IP. Try again later.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "too_many_requests",
                    "message": "Too many login attempts, try again later"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error"
                  }
                }
              }
            }
          }
        },
        "x-access": "public"
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Current user",
        "description": "Reads the account from the database, so the role is always current.\n\n**Access:** authenticated (any logged-in account)",
        "operationId": "get_auth_me",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The logged-in user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthenticated",
                    "message": "Authentication required"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error"
                  }
                }
              }
            }
          }
        },
        "x-access": "authenticated"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "validation_error"
              },
              "message": {
                "type": "string",
                "example": "Request validation failed"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      },
      "PublicUser": {
        "type": "object",
        "required": [
          "id",
          "role",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "TEACHER",
              "USER"
            ]
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "LoginResult": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "user"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT. Send as `Authorization: Bearer <token>`."
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer",
            "description": "Lifetime in seconds.",
            "example": 3600
          },
          "user": {
            "$ref": "#/components/schemas/PublicUser"
          }
        }
      },
      "TeacherLoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "format": "password"
          }
        }
      },
      "StudentLoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]{3,32}$",
            "description": "Case-insensitive."
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "format": "password"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/PublicUser"
          }
        }
      }
    }
  }
}

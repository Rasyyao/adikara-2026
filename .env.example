# Postgres (docker-compose.yml)
POSTGRES_USER=adikara
POSTGRES_PASSWORD=adikara
POSTGRES_DB=adikara

# API
DATABASE_URL=postgresql://adikara:adikara@localhost:5433/adikara
PORT=8080
# Required, at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=60
BCRYPT_COST=12
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Seed (local only): first admin account
SEED_ADMIN_EMAIL=admin@adikara.com
SEED_ADMIN_PASSWORD=
